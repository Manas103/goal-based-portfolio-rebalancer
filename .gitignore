# Maven build output (backend). Regenerate with: mvn clean package
target/
*.class

# Angular build output and deps (console). Regenerate with: npm install && npm run build
console/node_modules/
console/dist/
console/.angular/
console/out-tsc/

# Python venv and caches (optimizer). Regenerate with: cd optimizer && python -m venv venv && pip install -r requirements.txt
optimizer/venv/
optimizer/.pytest_cache/
optimizer/**/__pycache__/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
